{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth/[...nextauth]" },
    { "source": "/api/trpc/(.*)", "destination": "/api/trpc/..." },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_VERCEL_URL": "$VERCEL_URL"
    }
  }
}
